# Copy to /home/USER/everynation/.env on the server and fill in the values.
APP_NAME="Every Nation Bekasi"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://www.domain-anda.com
APP_TIMEZONE=Asia/Jakarta

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_LEVEL=warning

# cPanel → MySQL Databases (nama database & user biasanya diawali username cPanel)
DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=cpaneluser_everynation
DB_USERNAME=cpaneluser_enb
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=public
CACHE_STORE=database

# Shared hosting: the scheduler (cron every minute) processes the queue.
QUEUE_CONNECTION=database
QUEUE_VIA_SCHEDULER=true

# cPanel → Email Accounts (buat mis. no-reply@domain-anda.com)
MAIL_MAILER=smtp
MAIL_SCHEME=smtps
MAIL_HOST=mail.domain-anda.com
MAIL_PORT=465
MAIL_USERNAME=no-reply@domain-anda.com
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="no-reply@domain-anda.com"
MAIL_FROM_NAME="${APP_NAME}"

# Super Admin created by `php artisan db:seed --force`
ADMIN_EMAIL=admin
ADMIN_PASSWORD=

# Contoh/demo data (jemaat, LifeGroup, event, renungan…). Set false for a clean start.
SEED_DEMO=true
# Password for all demo accounts (min. 10 characters, required in production)
DEMO_PASSWORD=

VITE_APP_NAME="${APP_NAME}"
